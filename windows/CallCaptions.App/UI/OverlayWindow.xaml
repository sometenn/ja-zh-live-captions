<Window x:Class="CallCaptions.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CallCaptions.App.UI"
        Title="置顶字幕"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MinWidth="160"
        MinHeight="56"
        Width="560"
        Height="128"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="InvisibleResizeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ui:CaptionDisplayControl x:Name="DisplayControl" CornerRadiusValue="12" />

        <!-- 4 Edge resize thumbs -->
        <Thumb Height="7" VerticalAlignment="Top" Margin="12,0,12,0"
               Cursor="SizeNS" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeTop_DragDelta" />
        <Thumb Height="7" VerticalAlignment="Bottom" Margin="12,0,12,0"
               Cursor="SizeNS" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeBottom_DragDelta" />
        <Thumb Width="7" HorizontalAlignment="Left" Margin="0,12,0,12"
               Cursor="SizeWE" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeLeft_DragDelta" />
        <Thumb Width="7" HorizontalAlignment="Right" Margin="0,12,0,12"
               Cursor="SizeWE" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeRight_DragDelta" />

        <!-- 4 Corner resize thumbs -->
        <Thumb Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
               Cursor="SizeNWSE" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeTopLeft_DragDelta" />
        <Thumb Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
               Cursor="SizeNESW" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeTopRight_DragDelta" />
        <Thumb Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Cursor="SizeNESW" Style="{StaticResource InvisibleResizeThumb}"
               DragStarted="Resize_DragStarted" DragDelta="ResizeBottomLeft_DragDelta" />

        <!-- Bottom-right visible resize grip -->
        <Thumb Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,3,3"
               Cursor="SizeNWSE"
               DragStarted="Resize_DragStarted"
               DragDelta="ResizeBottomRight_DragDelta"
               ToolTip="拖动任意边缘或边角调整字幕窗大小">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 14,4 L 4,14 M 14,9 L 9,14"
                              Stroke="#66FFFFFF"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Close button kept above top-right resize zone -->
        <Button x:Name="CloseButton"
                Content="✕"
                Width="22"
                Height="22"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Background="#40FFFFFF"
                Foreground="White"
                BorderThickness="0"
                FontSize="11"
                Cursor="Hand"
                ToolTip="收起置顶字幕"
                Click="CloseButton_Click"
                Opacity="0.65">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
