<UserControl x:Class="CallCaptions.App.UI.CaptionDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder" CornerRadius="14" Padding="20,16">
        <Grid VerticalAlignment="Center">
            <StackPanel x:Name="ContentStack" VerticalAlignment="Center">
                <TextBlock x:Name="BannerText"
                           Visibility="Collapsed"
                           FontSize="13"
                           Foreground="#FFD95A"
                           Margin="0,0,0,6"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TopText" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,6" />
                <TextBlock x:Name="BottomText" TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ProbeStatusText"
                           Visibility="Collapsed"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,6" />
                <TextBlock x:Name="ProbeMeterText"
                           Visibility="Collapsed"
                           FontFamily="Consolas"
                           FontSize="24"
                           Foreground="#A6F7D4" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
