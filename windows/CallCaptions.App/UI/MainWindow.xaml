<Window x:Class="CallCaptions.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CallCaptions.App.UI"
        Title="日语实时字幕"
        Width="620"
        Height="690"
        MinWidth="545"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2D3737" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#111919" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E2727" />
            <Setter Property="BorderBrush" Value="#D2DADA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF3F3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="字" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="日语实时字幕" FontSize="22" FontWeight="SemiBold" Foreground="#131D1D" />
                    <TextBlock Text="日语 → 简体中文" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="KeyButton"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="🔑 密钥"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="KeyButton_Click" />
        </DockPanel>

        <!-- Preview section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="PreviewTitleText"
                           Text="字幕预览"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="ToggleOverlayButton"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="开启置顶字幕"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,4"
                        Click="ToggleOverlayButton_Click" />
            </DockPanel>

            <Border CornerRadius="15" ClipToBounds="True" MinHeight="145" MaxHeight="205">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33808080" Offset="0" />
                        <GradientStop Color="#8C808080" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <ui:CaptionDisplayControl x:Name="PreviewControl" CornerRadiusValue="15" MinHeight="145" />
            </Border>
        </StackPanel>

        <!-- Settings Card -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Border Background="#E7ECEC" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SessionTabRadio"
                                         GroupName="SettingsTab"
                                         Content="会话设置"
                                         IsChecked="True"
                                         Style="{StaticResource SegmentedButtonStyle}"
                                         Checked="SettingsTab_Changed" />
                            <RadioButton x:Name="AppearanceTabRadio"
                                         GroupName="SettingsTab"
                                         Content="字幕外观"
                                         Style="{StaticResource SegmentedButtonStyle}"
                                         Checked="SettingsTab_Changed" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RestoreDefaultsButton"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="恢复默认外观"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4"
                            Visibility="Collapsed"
                            Click="RestoreDefaultsButton_Click" />
                </DockPanel>

                <Separator Background="{StaticResource BorderBrushSubtle}" Margin="0,0,0,14" />

                <!-- Session settings panel -->
                <StackPanel x:Name="SessionPanel">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="翻译服务" VerticalAlignment="Center" FontSize="13" />
                        <Border Grid.Column="1" Background="#E7ECEC" CornerRadius="8" Padding="3" HorizontalAlignment="Stretch">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="SonioxRadio" GroupName="Provider" Content="Soniox"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="ProviderRadio_Checked" />
                                <RadioButton x:Name="GeminiRadio" GroupName="Provider" Content="Gemini"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="ProviderRadio_Checked" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="收音来源" VerticalAlignment="Center" FontSize="13" />
                        <Border Grid.Column="1" Background="#E7ECEC" CornerRadius="8" Padding="3" HorizontalAlignment="Stretch">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="SystemAudioRadio" GroupName="AudioSource" Content="机内声音"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="SourceRadio_Checked" />
                                <RadioButton x:Name="MicAudioRadio" GroupName="AudioSource" Content="麦克风"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="SourceRadio_Checked" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字幕显示" VerticalAlignment="Center" FontSize="13" />
                        <Border Grid.Column="1" Background="#E7ECEC" CornerRadius="8" Padding="3" HorizontalAlignment="Stretch">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="BilingualRadio" GroupName="DisplayMode" Content="双语字幕"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="DisplayModeRadio_Checked" />
                                <RadioButton x:Name="ChineseOnlyRadio" GroupName="DisplayMode" Content="仅大号中文"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="DisplayModeRadio_Checked" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="SessionPrivacyText"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Appearance settings panel -->
                <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字幕字体" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="FontFamilyCombo"
                                  Grid.Column="1"
                                  Padding="8,5"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectionChanged="FontFamilyCombo_SelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日语字号" VerticalAlignment="Center" FontSize="13" />
                        <Slider x:Name="SourceSizeSlider"
                                Grid.Column="1"
                                Minimum="12" Maximum="34" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="AppearanceSlider_ValueChanged" />
                        <TextBlock x:Name="SourceSizeLabel" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="中文字号" VerticalAlignment="Center" FontSize="13" />
                        <Slider x:Name="TranslationSizeSlider"
                                Grid.Column="1"
                                Minimum="16" Maximum="52" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="AppearanceSlider_ValueChanged" />
                        <TextBlock x:Name="TranslationSizeLabel" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="译文颜色" VerticalAlignment="Center" FontSize="13" />
                        <Border Grid.Column="1" Background="#E7ECEC" CornerRadius="8" Padding="3">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="InkWhiteRadio" GroupName="CaptionInk" Content="白色"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="InkRadio_Checked" />
                                <RadioButton x:Name="InkMintRadio" GroupName="CaptionInk" Content="薄荷"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="InkRadio_Checked" />
                                <RadioButton x:Name="InkAmberRadio" GroupName="CaptionInk" Content="暖黄"
                                             Style="{StaticResource SegmentedButtonStyle}" Checked="InkRadio_Checked" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="底色浓度" VerticalAlignment="Center" FontSize="13" />
                        <Slider x:Name="OpacitySlider"
                                Grid.Column="1"
                                Minimum="25" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="AppearanceSlider_ValueChanged" />
                        <TextBlock x:Name="OpacityLabel" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <Separator Background="{StaticResource BorderBrushSubtle}" Margin="0,0,0,12" />
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="340" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="ProbeButton"
                            Content="测试收音"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="ProbeButton_Click" />
                    <Button x:Name="StartButton"
                            Content="▶ 开始翻译"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="StartButton_Click" />
                    <Button x:Name="StopButton"
                            Content="■ 结束收音"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="StopButton_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
