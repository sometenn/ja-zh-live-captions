<Application x:Class="CallCaptions.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1A8273" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#156E61" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F4F6F6" />
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#E0E5E5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6B6B" />
    </Application.Resources>
</Application>
